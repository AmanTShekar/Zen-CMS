# 📦 Zenith Package Manager Rules (.npmrc)
# Enforces exact version pinning, local workspace resolving, and lockfile speedups.

# Force exact version saving to prevent dependency drifts (caret/tilde bypass)
save-exact=true

# Link workspace packages together immediately so local code changes sync instantly
link-workspace-packages=true

# Resolve dependencies inside the workspace first, avoiding unnecessary NPM registry fetches
prefer-workspace-packages=true

# Enterprise Best Practice: Do not strictly enforce peer dependencies. Strict mode causes CI/CD fragility
# when packages update transient React/Vite versions. Instead, automatically install them to resolve graph silently.
strict-peer-dependencies=false
auto-install-peers=true

# Hoist essential tooling so IDEs (VSCode/WebStorm) can find them at the workspace root
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*typescript*

# Enforce engine versions to prevent "it works on my machine" syndrome
engine-strict=true

# Optimise concurrency for monorepos
child-concurrency=10
